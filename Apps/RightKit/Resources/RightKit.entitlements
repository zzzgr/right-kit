<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Direct (Developer ID) distribution: the host app is not sandboxed, which is
	     precisely why file work and app launching happen here and not in the appex. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>SAXZHR4HFD.com.rightkit.app</string>
	</array>
</dict>
</plist>
