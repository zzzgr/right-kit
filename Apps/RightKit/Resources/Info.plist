<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>右键助手</string>
	<key>CFBundleDisplayName</key>
	<string>右键助手</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<!-- Menu-bar utility: no Dock icon, no app menu. -->
	<key>LSUIElement</key>
	<true/>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<!-- User-configured markets support HTTP as well as HTTPS. Requests still
	     validate their origin, response size, and package digest. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>「右键助手」需要连接你配置的局域网动作市场，以读取动作、图标和版本信息。</string>
	<!--
	  Purpose strings for the folder-access prompts macOS shows the first time an
	  action touches a protected folder. RightKit never pre-requests them.
	  There is deliberately no NSAppleEventsUsageDescription: terminals are opened
	  through LaunchServices, so no Automation permission is involved.
	-->
	<key>NSDesktopFolderUsageDescription</key>
	<string>「右键助手」需要访问桌面，才能在这里执行右键菜单里的操作。</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>「右键助手」需要访问文稿，才能在这里执行右键菜单里的操作。</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>「右键助手」需要访问下载，才能在这里执行右键菜单里的操作。</string>
	<key>NSRemovableVolumesUsageDescription</key>
	<string>「右键助手」需要访问可移动磁盘，才能在这里执行右键菜单里的操作。</string>
	<key>NSNetworkVolumesUsageDescription</key>
	<string>「右键助手」需要访问网络磁盘，才能在这里执行右键菜单里的操作。</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 乌鸡哥. All rights reserved.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- Handoff channel from the Finder extension: rightkit://run?action=… -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.rightkit.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>rightkit</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
